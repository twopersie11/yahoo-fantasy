# Server configuration
PORT=8443

# Yahoo OAuth credentials
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:8443/login/oauth2/code/yahoo
YAHOO_SCOPE=openid fspt-r profile email

# Express session secret for securing cookies
SESSION_SECRET=replace-with-random-string

# Optional comma-separated list of origins allowed via CORS
CORS_ORIGINS=https://localhost:3000,http://localhost:3000

# Location where the HTTPS key/cert live (created via npm run cert:gen)
TLS_KEY=certs/dev/key.pem
TLS_CRT=certs/dev/cert.pem

# Optional absolute/relative path for storing Yahoo tokens
TOKEN_STORE=.data/yahoo_tokens.json

# Optional redirect after successful login
POST_LOGIN_REDIRECT=https://localhost:3000
